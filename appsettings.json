{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Kestrel will listen on this URL when running locally.
  // In production as a Windows Service, change port as needed.
  "Urls": "http://localhost:5050",
  // ─── Active point ─────────────────────────────────────────────────────────
  // Change this to switch which branch/point the service runs for.
  // The matching config/points/{ActivePointId}.json will be loaded on top of this file.
  "ActivePointId": "aport",
  // ─── Global service settings (shared across all points) ──────────────────
  "LedUpdater": {
    "RunMode": "RenderOnly",
    "PublishMode": "WifiFtp",
    "PollSeconds": 10,
    "FtpUser": "guest",
    "FtpPassword": "guest",
    "UseTls": false,
    "FtpPort": 21,
    "SkipIfUnchanged": true,
    // true = recompose every poll cycle (ignore change detection).
    "ForceComposeEveryPoll": true,
    // true = force RenderOnly and disable board auto-send for layout testing.
    "LayoutTestMode": true,
    "EnforceWifiOnly": false,
    "RequirePrivateAddress": true,
    // Live rate fetching — applies to ALL points (index.json maps depCode per point)
    "RatesApiUrl": "https://api.quiq.kz/Department/getDepsLandingInfo",
    "RatesFetchIntervalMinutes": 10,
    // ─── Point-specific values below are injected from config/points/{ActivePointId}.json ───
    // WatchFolder, ScreenXmlPath, ComposeConfigPath, RatesJsonPath,
    // ForceRemoteRoot, NetworkJsonPath, RelayOutRoot, ControllerReloadUrl
    "WatchFolder": "",
    "ScreenXmlPath": "config/screen.xml"
  },
  // ─── Onbon BX-Y SDK configuration ───────────────────────────────────────────
  // Set Enabled=false when developing on macOS to skip DLL calls.
  // On Windows production, set Enabled=true; point-specific IP/screen size come
  // from config/points/{ActivePointId}.json.
  "OnbonLed": {
    "Enabled": true,
    "UserName": "guest",
    "Password": "guest",
    // Local temp folder the SDK uses to stage program packages
    "TempPath": "onbon-temp",
    // Retry policy for send/clear operations
    "RetryCount": 2,
    "RetryDelayMs": 2000,
    // TCP connectivity check timeout (ms)
    "ConnectionTimeoutMs": 3000,
    // LedBoardService polling interval (seconds)
    "PollSeconds": 30,
    // false = generate images automatically but do NOT auto-send to board.
    // Use Swagger UI at http://localhost:5050 to send manually.
    "AutoSend": true,
    // true = execute upload/send in helper process so native SDK failures
    // do not terminate the main API process.
    "UseIsolatedSender": true,
    // Skip repeated uploads if normalized BMP payload did not change.
    "SkipDuplicateUploads": true,
    // true = reject publish when input image size differs from ScreenWidth/ScreenHeight.
    "RejectSizeMismatchBeforePublish": true,
    // ─── Point-specific values below are injected from config/points/{ActivePointId}.json ───
    // ControllerIp, ControllerPort, ScreenWidth, ScreenHeight, DeviceType
    "ControllerIp": "0.0.0.0",
    "ScreenWidth": 1,
    "ScreenHeight": 1
  }
}