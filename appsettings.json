{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Kestrel will listen on this URL when running locally.
  // In production as a Windows Service, change port as needed.
  "Urls": "http://localhost:5050",
  // ─── Active point ─────────────────────────────────────────────────────────
  // Change this to switch which branch/point the service runs for.
  // The matching config/points/{ActivePointId}.json will be loaded on top of this file.
  "ActivePointId": "aport2",
  // ─── Admin password ───────────────────────────────────────────────────────
  // Gates the full "Настройки (администратор)" window. Cashiers use the
  // simplified window (no password). Change this to set a new password;
  // an empty value disables the password prompt entirely.
  "AdminPassword": "admin",
  // ─── Global service settings (shared across all points) ──────────────────
  "LedUpdater": {
    "RunMode": "RenderOnly",
    "PublishMode": "WifiFtp",
    "PollSeconds": 10,
    "FtpUser": "guest",
    "FtpPassword": "guest",
    "UseTls": false,
    "FtpPort": 21,
    "SkipIfUnchanged": true,
    // true = recompose every poll cycle (ignore change detection).
    "ForceComposeEveryPoll": false,
    // true = force RenderOnly and disable board auto-send for layout testing.
    "LayoutTestMode": false,
    // true (default) = point has permanent internet: rates fetched, image rendered AND auto-sent
    // to the board on the poll timer. false = no stable internet: rates/image still update, but the
    // board is sent only manually via the "Отправить на табло" button on the Design tab.
    "PermanentInternet": true,
    "EnforceWifiOnly": false,
    "RequirePrivateAddress": true,
    // Wi-Fi network name (SSID) of the board's access point. When set and a delivery
    // problem is detected, the app checks the PC's current Wi-Fi and shows a separate,
    // always-on-top red alert (independent of the cashier window) that cannot be closed
    // until the PC reconnects to this network.
    // Leave empty to disable the check. Can be overridden per point in config/points/{id}.json.
    "WifiSsid": "",
    // Live rate fetching — applies to ALL points (index.json maps depCode per point)
    "RatesApiUrl": "https://api.quiq.kz/Department/getDepsLandingInfo",
    "RatesFetchIntervalMinutes": 1,
    // ─── Point-specific values below are injected from config/points/{ActivePointId}.json ───
    // WatchFolder, ScreenXmlPath, ComposeConfigPath, RatesJsonPath,
    // ForceRemoteRoot, NetworkJsonPath, RelayOutRoot, ControllerReloadUrl
    "WatchFolder": "",
    "ScreenXmlPath": "config/screen.xml"
  },
  // ─── Telegram notifications (optional) ──────────────────────────────────────
  // When Enabled=true and BotToken/ChatId are set, the service sends a message when
  // a board update fails (rate changed but image could not be delivered) and again
  // when delivery recovers. Get a token from @BotFather; ChatId can be obtained from
  // @userinfobot or the getUpdates API. Leave Enabled=false to disable entirely.
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "ChatId": ""
  },
  // ─── LED controller family ──────────────────────────────────────────────────
  // This application drives Onbon BX-Y cards (via YQNetCom.dll) only.
  // The Huidu / HDPlayer family lives in the separate "eCash Tablo Huidu" application.
  "Led": {
    "Family": "Onbon"
  },
  // ─── Onbon BX-Y SDK configuration ───────────────────────────────────────────
  // Set Enabled=false when developing on macOS to skip DLL calls.
  // On Windows production, set Enabled=true; point-specific IP/screen size come
  // from config/points/{ActivePointId}.json.
  "OnbonLed": {
    "Enabled": true,
    "UserName": "guest",
    "Password": "guest",
    // Local temp folder the SDK uses to stage program packages
    "TempPath": "onbon-temp",
    // Retry policy for send/clear operations
    "RetryCount": 2,
    "RetryDelayMs": 2000,
    // TCP connectivity check timeout (ms)
    "ConnectionTimeoutMs": 3000,
    // LedBoardService polling interval (seconds)
    "PollSeconds": 10,
    // false = generate images automatically but do NOT auto-send to board.
    // Use Swagger UI at http://localhost:5050 to send manually.
    "AutoSend": true,
    // true = execute upload/send in helper process so native SDK failures
    // do not terminate the main API process.
    "UseIsolatedSender": true,
    // Skip repeated uploads if normalized BMP payload did not change.
    "SkipDuplicateUploads": true,
    // true = reject publish when input image size differs from ScreenWidth/ScreenHeight.
    "RejectSizeMismatchBeforePublish": true,
    // ─── Point-specific values below are injected from config/points/{ActivePointId}.json ───
    // ControllerIp, ControllerPort, ScreenWidth, ScreenHeight, DeviceType
    "ControllerIp": "192.168.22.2",
    "ScreenWidth": 128,
    "ScreenHeight": 256
  }
}